{
  "name": "euclid-prep-client",
  "version": "1.0.0",
  "description": "面向个人使用的 macOS 欧几里得数学竞赛备考客户端：本地归档、可审核 OCR、统一作答与可审计评分。",
  "author": "dfdd2001-source",
  "type": "module",
  "license": "MIT",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "test": "vitest run",
    "build": "pnpm build:renderer && pnpm build:electron",
    "check": "tsc --noEmit",
    "dev:desktop": "concurrently -k \"pnpm dev\" \"wait-on http://127.0.0.1:3000 && pnpm build:electron && VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron dist/electron/main.js\"",
    "build:renderer": "vite build",
    "build:electron": "esbuild electron/main.ts electron/archive.ts electron/database.ts electron/ocr.ts electron/review-media.ts electron/ai-config.ts electron/ai-runtime.ts electron/practice.ts electron/backup.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/electron && esbuild electron/preload.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/electron/preload.js",
    "package:mac": "VITE_ELECTRON_FILE_PROTOCOL=1 pnpm build && electron-builder --mac dmg --arm64",
    "preview": "vite preview --host",
    "format": "prettier --write .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint ."
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "katex": "^0.18.9",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "wouter": "^3.3.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "add": "^2.0.6",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pnpm": "^10.15.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.4",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "build": {
    "appId": "com.myeuclid.client",
    "productName": "My Euclid",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@napi-rs/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "packaging/icon.icns"
    }
  }
}
